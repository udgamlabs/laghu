  "num_kv_shared_layers": 0,
  "rope_parameters": {
    "sliding_attention": {
      "rope_type": "default",
      "rope_theta": 10000.0
    },
    "full_attention": {
      "rope_type": "proportional",
      "partial_rotary_factor": 1.0,
      "rope_theta": 1000000.0
    }
  },
  "final_logit_softcapping": 15.0,
  "tie_word_embeddings": false,
  "bos_token_id": 2,
