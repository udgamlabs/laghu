{
  "architectures": [
    "Gemma4ForCausalLM"
  ],
  "model_type": "gemma4_text",
  "vocab_size": 32768,
  "hidden_size": 128,
  "intermediate_size": 256,
  "num_hidden_layers": 4,
  "num_attention_heads": 2,
